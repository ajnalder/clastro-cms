---
import { getCurrentUser } from "../../lib/auth";

const user = await getCurrentUser(Astro.request, Astro.locals);
const errorParam = Astro.url.searchParams.get("error");
const initialError =
  errorParam === "missing_credentials"
    ? "Email and password are required."
    : errorParam === "invalid_credentials"
      ? "Invalid email or password."
      : "";

if (user) {
  return Astro.redirect("/admin");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login | Clastro CMS</title>
    <style>
      :root { color-scheme: light; --cms-navy: #020024; --cms-navy-soft: #08145a; --cms-cyan: #00d4ff; --cms-cyan-border: #9defff; }
      body { align-items: center; background: radial-gradient(circle at 18% 18%, rgba(0, 212, 255, 0.16), transparent 28%), linear-gradient(135deg, var(--cms-navy) 0%, var(--cms-navy-soft) 42%, #f2f8fb 42%, #f2f8fb 100%); color: #17191c; display: grid; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; min-height: 100vh; padding: 1.5rem; }
      .card { background: #fff; border: 1px solid #d9dfe5; border-radius: 18px; box-shadow: 0 24px 70px rgba(2, 0, 36, 0.18); display: grid; gap: 0.15rem; max-width: 430px; padding: 1.5rem; width: 100%; }
      .logoPanel { align-items: center; background: linear-gradient(90deg, var(--cms-navy) 0%, var(--cms-navy-soft) 100%); border-radius: 12px; display: flex; margin-bottom: 1.35rem; min-height: 4.25rem; padding: 0.85rem 1rem; }
      .logo { display: block; height: auto; max-width: 12rem; width: 100%; }
      .eyebrow { color: #067aa1; display: inline-block; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; margin-bottom: 0.75rem; text-transform: uppercase; }
      h1 { font-size: 1.75rem; line-height: 1.1; margin: 0 0 0.5rem; }
      p { color: #66707a; margin: 0 0 1rem; }
      form { display: grid; gap: 0.9rem; }
      label { display: grid; gap: 0.45rem; }
      label span { font-size: 0.9rem; font-weight: 600; }
      input { background: #fff; border: 1px solid #d4dae1; border-radius: 12px; color: inherit; font: inherit; min-height: 2.9rem; padding: 0.85rem 0.95rem; }
      input:focus { border-color: var(--cms-cyan); box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.14); outline: none; }
      button { background: var(--cms-cyan); border: 0; border-radius: 10px; color: var(--cms-navy); cursor: pointer; font: inherit; font-weight: 800; min-height: 2.9rem; padding: 0.9rem 1.2rem; }
      button:hover { background: #5be5ff; }
      .status { border-radius: 12px; display: none; font-size: 0.95rem; margin-top: 0.5rem; padding: 0.85rem 1rem; }
      .status.is-visible { display: block; }
      .status.is-error { background: rgba(171, 54, 54, 0.12); color: #8b2525; }
    </style>
  </head>
  <body>
    <section class="card">
      <div class="logoPanel"><img alt="Clastro CMS" class="logo" src="/images/clastro-logo.svg" /></div>
      <span class="eyebrow">CMS Admin</span>
      <h1>Sign in</h1>
      <p>Access the content dashboard and live editing tools.</p>
      <p style="font-size: 0.9rem; margin-top: -0.35rem;">If someone invited you to this CMS, use the invite link they sent first to set up your login.</p>

      <form id="login-form" method="post" action="/api/auth/login?redirect=%2Fadmin">
        <label>
          <span>Email</span>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Password</span>
          <input id="password" name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Log In</button>
      </form>

      <div class={`status${initialError ? " is-visible is-error" : ""}`} id="status">
        {initialError}
      </div>
    </section>

    <script is:inline>
      const form = document.getElementById("login-form");

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const status = document.getElementById("status");

        status?.classList.remove("is-visible", "is-error");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              accept: "application/json",
              "content-type": "application/x-www-form-urlencoded;charset=UTF-8",
            },
            body: new URLSearchParams(new FormData(form)),
          });

          if (!response.ok) {
            const data = await response.json().catch(() => null);
            status.textContent = data?.error || "Invalid email or password.";
            status.classList.add("is-visible", "is-error");
            return;
          }

          window.location.href = "/admin";
        } catch {
          status.textContent = "An unexpected error occurred.";
          status.classList.add("is-visible", "is-error");
        }
      });
    </script>
  </body>
</html>
