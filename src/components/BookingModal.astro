---
import { DEFAULT_SITE_SETTINGS, type SiteSettings } from "../lib/defaults";

interface Props {
  booking?: SiteSettings["booking"];
}

const { booking = DEFAULT_SITE_SETTINGS.booking } = Astro.props;
---

<div class="booking-modal" id="booking-modal" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title" hidden>
  <button class="booking-modal-backdrop" type="button" aria-label="Close booking modal" data-booking-close></button>
  <section class="booking-modal-panel">
    <button class="booking-modal-close" type="button" aria-label="Close booking modal" data-booking-close>Close</button>
    <p class="eyebrow">Demo Action</p>
    <h2 id="booking-modal-title">Choose a next step</h2>
    <div class="booking-modal-grid">
      <a href={booking.consultation.href}>
        <strong>{booking.consultation.title}</strong>
        <span>{booking.consultation.duration} - {booking.consultation.price}</span>
        <p>{booking.consultation.description}</p>
      </a>
      <a href={booking.session.href}>
        <strong>{booking.session.title}</strong>
        <span>{booking.session.duration} - {booking.session.price}</span>
        <p>{booking.session.description}</p>
      </a>
    </div>
    <p>{booking.note}</p>
  </section>
</div>
