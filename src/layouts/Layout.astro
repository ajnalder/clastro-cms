---
import SiteLayout from "./SiteLayout.astro";

interface Props {
  description: string;
  image?: string;
  lang?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  stylesheets?: string[];
  title: string;
  type?: "article" | "website";
}

const props = Astro.props as Props;
---

<SiteLayout {...props}>
  <slot />
</SiteLayout>
