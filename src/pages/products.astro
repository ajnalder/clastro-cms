---
import SiteLayout from "../layouts/SiteLayout.astro";
import RecoveredPage from "../layouts/RecoveredPage.astro";
import {
  getPageBySlug,
  listCatalogProducts,
  listContentItems,
} from "../lib/repository";

export const prerender = false;

const cmsPage = await getPageBySlug(Astro.locals, "products");
const products = await listCatalogProducts(Astro.locals);
const categoryItems = await listContentItems(Astro.locals, "category");

const categoryBySlug = new Map<string, { data: Record<string, unknown>; published: boolean; slug: string }>();
for (const item of categoryItems) {
  categoryBySlug.set(item.slug, item);
}

const grouped = new Map<string, typeof products>();
for (const product of products) {
  const key = product.categorySlug || "_uncategorised";
  if (!grouped.has(key)) {
    grouped.set(key, []);
  }
  grouped.get(key)!.push(product);
}

const groups = Array.from(grouped.entries()).map(([slug, items]) => {
  const category = categoryBySlug.get(slug);
  const data = category?.data ?? {};
  const name =
    (typeof data.name === "string" && data.name) ||
    items[0]?.categoryLabel ||
    "Uncategorised";
  const description = typeof data.description === "string" ? data.description : "";
  const heroImageUrl = typeof data.heroImageUrl === "string" ? data.heroImageUrl : "";
  const heroImageAlt = typeof data.heroImageAlt === "string" ? data.heroImageAlt : "";
  return { description, heroImageAlt, heroImageUrl, items, name, slug };
});

groups.sort((a, b) => a.name.localeCompare(b.name));

const featured = products.filter((product) => product.isFrontPage).slice(0, 4);
const totalCount = products.length;
const categoryCount = groups.length;
---

{cmsPage && (
  <RecoveredPage
    {...cmsPage}
    stylesheets={cmsPage.stylesheets}
    contentHtml={cmsPage.contentHtml}
  />
)}

{!cmsPage && (
  <SiteLayout
    description="Demo catalogue of products managed through the Clastro CMS. Each card pulls its category from the Categories content collection."
    title="Products | Clastro Demo"
  >
    <main class="page-shell section-pad">
      <section class="content-band">
        <p class="eyebrow">Catalogue</p>
        <h1>Products</h1>
        <p>
          Every entry below is editable from the CMS. Products live in their own collection; the
          category on each card is a reference to a record in the Categories content collection &mdash;
          change a category name there and it updates everywhere it&apos;s referenced.
        </p>
        {totalCount > 0 && (
          <p>
            <strong>{totalCount}</strong> product{totalCount === 1 ? "" : "s"} across{" "}
            <strong>{categoryCount}</strong> categor{categoryCount === 1 ? "y" : "ies"}.
          </p>
        )}
      </section>

      {totalCount === 0 && (
        <section class="section-stack">
          <div class="content-band">
            <h2>No products yet</h2>
            <p>
              Add a product from the admin under <a href="/admin">Content Items &rarr; Products</a>,
              or run <code>npm run seed:demo</code> to load the starter records.
            </p>
          </div>
        </section>
      )}

      {featured.length > 0 && (
        <section class="section-stack">
          <div class="section-heading">
            <p class="eyebrow">Featured</p>
            <h2>On the front page.</h2>
            <p>
              Products with the <em>Featured on front-end lists</em> toggle in the admin appear here first.
            </p>
          </div>
          <div class="product-grid">
            {featured.map((product) => (
              <article class="product-card">
                <a class="product-card-thumb" href={`/products/${product.slug}`}>
                  {product.heroImageUrl ? (
                    <img alt={product.heroImageAlt || product.name} loading="lazy" src={product.heroImageUrl} />
                  ) : (
                    <span class="product-card-thumb-empty">No image</span>
                  )}
                </a>
                <div class="product-card-body">
                  <p class="eyebrow">{product.categoryLabel || "Product"}</p>
                  <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
                  {product.shortDescription && <p class="product-card-summary">{product.shortDescription}</p>}
                  <div class="product-card-foot">
                    {(() => {
                      const label = (product.priceLabel || "").trim();
                      const hasPrice = typeof product.price === "number" && product.price > 0;
                      const meaningfulLabel = label && label !== "$";
                      const display = hasPrice
                        ? `${label && label !== "$" ? `${label} ` : "$"}${product.price}`
                        : meaningfulLabel
                          ? label
                          : "";
                      return display ? <strong>{display}</strong> : <span />;
                    })()}
                    <a class="text-link" href={`/products/${product.slug}`}>View &rarr;</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {groups.map((group) => (
        <section class="section-stack" id={`category-${group.slug}`}>
          <div class="section-heading">
            <p class="eyebrow">Category</p>
            <h2>{group.name}</h2>
            {group.description && <p>{group.description}</p>}
            {!group.description && !categoryBySlug.has(group.slug) && (
              <p>
                Add a <a href="/admin">Category content item</a> with the slug <code>{group.slug}</code>{" "}
                to enrich this section with a hero image and description.
              </p>
            )}
          </div>

          {group.heroImageUrl && (
            <img
              alt={group.heroImageAlt || group.name}
              class="category-hero"
              src={group.heroImageUrl}
            />
          )}

          <div class="product-grid">
            {group.items.map((product) => (
              <article class="product-card">
                <a class="product-card-thumb" href={`/products/${product.slug}`}>
                  {product.heroImageUrl ? (
                    <img alt={product.heroImageAlt || product.name} loading="lazy" src={product.heroImageUrl} />
                  ) : (
                    <span class="product-card-thumb-empty">No image</span>
                  )}
                </a>
                <div class="product-card-body">
                  <p class="eyebrow">{product.categoryLabel || group.name}</p>
                  <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
                  {product.shortDescription && <p class="product-card-summary">{product.shortDescription}</p>}
                  <div class="product-card-foot">
                    {(() => {
                      const label = (product.priceLabel || "").trim();
                      const hasPrice = typeof product.price === "number" && product.price > 0;
                      const meaningfulLabel = label && label !== "$";
                      const display = hasPrice
                        ? `${label && label !== "$" ? `${label} ` : "$"}${product.price}`
                        : meaningfulLabel
                          ? label
                          : "";
                      return display ? <strong>{display}</strong> : <span />;
                    })()}
                    <a class="text-link" href={`/products/${product.slug}`}>View &rarr;</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </SiteLayout>
)}

<style is:global>
  .product-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    margin-top: 1.6rem;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .product-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  .product-card:hover {
    border-color: var(--color-cyan, var(--color-accent, #00a7c7));
    box-shadow: 0 18px 40px rgba(2, 0, 36, 0.08);
    transform: translateY(-2px);
  }

  .product-card-thumb {
    align-items: center;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: 1.5rem;
  }

  .product-card-thumb img {
    display: block;
    height: 100%;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    width: auto;
  }

  .product-card-thumb-empty {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .product-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .product-card-body .eyebrow {
    margin-bottom: 0;
  }

  .product-card-body h3 {
    font-size: 1.15rem;
    line-height: 1.25;
    margin: 0;
  }

  .product-card-body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .product-card-body h3 a:hover {
    text-decoration: underline;
  }

  .product-card-summary {
    color: var(--color-muted);
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  .product-card-foot {
    align-items: center;
    border-top: 1px dashed var(--color-line);
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.85rem;
  }

  .product-card-foot strong {
    font-size: 1rem;
  }

  .category-hero {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    margin-top: 1.6rem;
    object-fit: cover;
    width: 100%;
  }

  /* More breathing room between category sections on the products page */
  .page-shell > .section-stack {
    margin-top: 4rem;
  }

  @media (min-width: 900px) {
    .page-shell > .section-stack {
      margin-top: 5rem;
    }
  }
</style>
