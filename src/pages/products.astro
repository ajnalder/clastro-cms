---
import Layout from "../layouts/Layout.astro";
import { listCatalogProducts } from "../lib/repository";

const products = await listCatalogProducts(Astro.locals);
---

<Layout title="Products | Clastro Demo" description="Demo product records managed by the Clastro CMS.">
  <main class="page-shell">
    <section class="content-band">
      <p class="eyebrow">Products</p>
      <h1>Repeatable demo catalogue.</h1>
      <p>These generic records test product-style content, galleries, specs, pricing, and detail pages.</p>
    </section>

    <section class="card-list">
      {products.length > 0 ? products.map((product) => (
        <article>
          {product.heroImageUrl && <img src={product.heroImageUrl} alt={product.heroImageAlt || ""} />}
          <p class="eyebrow">{product.categoryLabel}</p>
          <h2><a href={`/products/${product.slug}`}>{product.name}</a></h2>
          <p>{product.shortDescription}</p>
          <a class="text-link" href={`/products/${product.slug}`}>View product</a>
        </article>
      )) : (
        <article>
          <h2>No demo products yet</h2>
          <p>Seed the database with `db/demo-seed.sql` or create a product in the admin.</p>
        </article>
      )}
    </section>
  </main>
</Layout>
